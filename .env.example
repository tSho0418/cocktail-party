# App database. Local: the docker-compose Postgres (`pnpm db:up`).
# Production (ADR 0001): Neon's pooled connection string, e.g.
# postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cocktail_party

# Server + credentials for `pnpm test:db`. Each run creates and drops its own
# cocktail_party_test_<random> database there; the database named here is only used to connect.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/postgres
