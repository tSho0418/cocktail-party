# App database. Local: the docker-compose Postgres (`pnpm db:up`).
# Preview/production (ADR 0001): Neon's connection string. node-postgres (the app, db:migrate, the
# seed scripts) treats sslmode=require as verify-full and warns that pg v9 will change it, so write
# sslmode=verify-full there. Not for pg_dump (the Backup workflow's secret): libpq's verify-full
# needs a root certificate file, keep sslmode=require. Which host (-pooler or direct) the app uses
# is undecided, see README "Preview"; db:migrate, the seeds and pg_dump use the direct host.
# postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=verify-full
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cocktail_party

# Server + credentials for `pnpm test:db`. Each run creates and drops its own
# cocktail_party_test_<random> database there; the database named here is only used to connect.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/postgres

# Cloudflare R2 for Photo derivatives (ADR 0001, 0003). The S3 API key needs Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL serving the bucket (custom domain or r2.dev), e.g. https://img.example.com
R2_PUBLIC_BASE_URL=

# Better Auth (ADR 0005). Secret: `openssl rand -base64 32`. URL: the public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# OAuth apps. Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google and .../callback/line
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
