# App database. Local: the docker-compose Postgres (`pnpm db:up`).
# Production (ADR 0001): Neon's pooled connection string, e.g.
# postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cocktail_party

# Database wiped and re-migrated by every `pnpm test:db` run. Never point this at real data.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/cocktail_party_test

# Cloudflare R2 for Photo derivatives (ADR 0001, 0003). The S3 API key needs Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL serving the bucket (custom domain or r2.dev), e.g. https://img.example.com
R2_PUBLIC_BASE_URL=
